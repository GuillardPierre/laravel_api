                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Erreur : Non autorisé (Token manquant ou invalide)"
                    },
                    "422": {
                        "description": "Erreur : Données invalides (Validation)"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
